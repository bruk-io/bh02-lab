{
 "cases": [
  {
   "name": "get missing gives default",
   "steps": [
    {
     "call": "cache:LRUCache",
     "args": [
      2
     ],
     "bind": "c"
    },
    {
     "on": "c",
     "method": "get",
     "args": [
      "x",
      7
     ],
     "expect": {
      "returns": 7
     }
    }
   ]
  },
  {
   "name": "put then get",
   "steps": [
    {
     "call": "cache:LRUCache",
     "args": [
      2
     ],
     "bind": "c"
    },
    {
     "on": "c",
     "method": "put",
     "args": [
      "a",
      1
     ]
    },
    {
     "on": "c",
     "method": "get",
     "args": [
      "a"
     ],
     "expect": {
      "returns": 1
     }
    },
    {
     "len": "c",
     "expect": {
      "returns": 1
     }
    }
   ]
  },
  {
   "name": "evicts least recently used",
   "steps": [
    {
     "call": "cache:LRUCache",
     "args": [
      2
     ],
     "bind": "c"
    },
    {
     "on": "c",
     "method": "put",
     "args": [
      "a",
      1
     ]
    },
    {
     "on": "c",
     "method": "put",
     "args": [
      "b",
      2
     ]
    },
    {
     "on": "c",
     "method": "get",
     "args": [
      "a"
     ]
    },
    {
     "on": "c",
     "method": "put",
     "args": [
      "c",
      3
     ]
    },
    {
     "on": "c",
     "method": "get",
     "args": [
      "b"
     ],
     "expect": {
      "returns": null
     }
    },
    {
     "on": "c",
     "method": "get",
     "args": [
      "a"
     ],
     "expect": {
      "returns": 1
     }
    },
    {
     "on": "c",
     "method": "get",
     "args": [
      "c"
     ],
     "expect": {
      "returns": 3
     }
    }
   ]
  },
  {
   "name": "put counts as use",
   "steps": [
    {
     "call": "cache:LRUCache",
     "args": [
      2
     ],
     "bind": "c"
    },
    {
     "on": "c",
     "method": "put",
     "args": [
      "a",
      1
     ]
    },
    {
     "on": "c",
     "method": "put",
     "args": [
      "b",
      2
     ]
    },
    {
     "on": "c",
     "method": "put",
     "args": [
      "a",
      10
     ]
    },
    {
     "on": "c",
     "method": "put",
     "args": [
      "c",
      3
     ]
    },
    {
     "on": "c",
     "method": "get",
     "args": [
      "a"
     ],
     "expect": {
      "returns": 10
     }
    },
    {
     "on": "c",
     "method": "get",
     "args": [
      "b"
     ],
     "expect": {
      "returns": null
     }
    }
   ]
  },
